{
  "buildCommand": "pnpm --filter @workspace/vocab-app run build",
  "outputDirectory": "artifacts/vocab-app/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite"
}
