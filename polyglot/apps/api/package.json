{
  "name": "@polyglot/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "workspace": "./src/app.ts",
      "types": "./src/app.ts",
      "default": "./dist/app.mjs"
    },
    "./app": {
      "workspace": "./src/app.ts",
      "types": "./src/app.ts",
      "default": "./dist/app.mjs"
    }
  },
  "scripts": {
    "dev": "LOG_PRETTY=1 PORT=${PORT:-5000} tsx watch src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@polyglot/api-zod": "workspace:*",
    "@polyglot/db": "workspace:*",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "esbuild": "^0.27.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
